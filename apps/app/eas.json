{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_IDS": "1"
      },
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true,
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ADS_MODE": "test",
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_IDS": "1"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADS_MODE": "production",
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_IDS": "0"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "production-local": {
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADS_MODE": "production",
        "EXPO_PUBLIC_ADMOB_FORCE_TEST_IDS": "0"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bonjin.app@gmail.com",
        "appleTeamId": "N99FMBQ662",
        "ascAppId": "6793449140"
      },
    "android": {
      "serviceAccountKeyPath": "./credentials/play-service-account.json",
      "track": "production",
      "releaseStatus": "completed"
    }
    }
  }
}
